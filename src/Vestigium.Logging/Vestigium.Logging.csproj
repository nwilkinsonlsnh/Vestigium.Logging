<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Build -->
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Vestigium.Logging</RootNamespace>
		<AssemblyName>Vestigium.Logging</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<IsPackable>true</IsPackable>

		<!-- Package identity -->
		<PackageId>Vestigium.Logging</PackageId>
		<Version>1.2.0</Version>
		<Authors>Vestigium</Authors>
		<Company>Wilkinson Business</Company>
		<Copyright>Copyright (c) 2026 Nathaniel Wilkinson / LSNH</Copyright>
		<Description>Centralized, subscribable logging module for the Vestigium suite — flat JSON Lines for PowerBI, flood protection, WPF-safe subscribers.</Description>
		<PackageTags>logging;wpf;mvvm;powerbi;vestigium;jsonl</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/nwilkinsonlsnh/Vestigium.Logging</PackageProjectUrl>
		<RepositoryUrl>https://github.com/nwilkinsonlsnh/Vestigium.Logging</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
		<None Include="_Documentation\**\*.md" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Vestigium.Logging.Tests" />
	</ItemGroup>

</Project>
