<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Build -->
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Vestigium.Logging</RootNamespace>
		<AssemblyName>Vestigium.Logging</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<IsPackable>true</IsPackable>

		<!-- Package identity -->
		<PackageId>Vestigium.Logging</PackageId>
		<Version>1.1.0</Version>
		<Authors>Vestigium</Authors>
		<Company>Wilkinson Business</Company>
		<Copyright>Copyright (c) 2026 Nathaniel Wilkinson / LSNH</Copyright>
		<Description>Centralized, subscribable Serilog logging module for the Vestigium suite — flat JSON for PowerBI, flood protection, WPF-safe subscribers.</Description>
		<PackageTags>logging;serilog;wpf;mvvm;powerbi;vestigium</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/nwilkinsonlsnh/Vestigium.Logging</PackageProjectUrl>
		<RepositoryUrl>https://github.com/nwilkinsonlsnh/Vestigium.Logging</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="_Documentation\Reports\Exports\" />
	</ItemGroup>

</Project>