<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="ConfigurationTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Identity and flood"/>
            <TextBlock Style="{StaticResource Caption}" Text="APPID"/>
            <TextBox Text="{Binding AppId, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding FloodThreshold, StringFormat=FloodThresholdCount = {0}}"/>
            <Slider Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FloodThreshold}"/>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding FloodWindowMs, StringFormat=FloodWindowMs = {0}}"/>
            <Slider Minimum="1000" Maximum="120000" TickFrequency="1000" IsSnapToTickEnabled="True" Value="{Binding FloodWindowMs}"/>
            <TextBlock Style="{StaticResource Caption}" Text="Minimum disk LEVEL"/>
            <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding MinimumDiskLevel}"/>
            <CheckBox Content="Simulate low disk (drop Verbose / Debug)" IsChecked="{Binding SimulateLowDisk}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Grid.Column="1">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Retention and disk tripwire"/>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding FileSizeMb, StringFormat=File size cap = {0} MB}"/>
            <Slider Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FileSizeMb}"/>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding RetainDays, StringFormat=Time retention = {0} days}"/>
            <Slider Minimum="1" Maximum="31" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RetainDays}"/>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding FileCap, StringFormat=Retained file cap = {0}}"/>
            <Slider Minimum="10" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FileCap}"/>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding DiskPercent, StringFormat=Free-space percent floor = {0}%}"/>
            <Slider Minimum="1" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DiskPercent}"/>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding DiskFloorGb, StringFormat=Hard floor = {0} GB}"/>
            <Slider Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DiskFloorGb}"/>
            <Button Content="Apply configuration" Command="{Binding ApplyConfigurationCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            <TextBlock Opacity="0.65" TextWrapping="Wrap" Text="{Binding StatusText}"/>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
