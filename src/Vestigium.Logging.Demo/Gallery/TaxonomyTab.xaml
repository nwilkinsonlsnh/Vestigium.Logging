<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="TaxonomyTab">
    <StackPanel>
      <TextBlock FontWeight="SemiBold" Text="Registered catalog"/>
      <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"
                 Text="Developers cannot invent category strings at runtime. Unknown pairs fall back to Uncategorized / Unregistered and emit a flood-protected internal Warning from APPID Vestigium.Logging."/>
      <ItemsControl ItemsSource="{Binding TaxonomyRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding Category}"/>
                <TextBlock Opacity="0.75" Text="{Binding Subcategories}"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="Write unregistered Widgets/Thing" Command="{Binding WriteUnregisteredCommand}" HorizontalAlignment="Left"/>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
