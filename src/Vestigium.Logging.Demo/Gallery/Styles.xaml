<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Vestigium.Logging.Demo">
  <local:LevelToBrushConverter x:Key="LevelBrush"/>

  <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style TargetType="Button">
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
    <Setter Property="Background" Value="#243E68"/>
    <Setter Property="Foreground" Value="#E2E8F0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#1E4A7A"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#E2E8F0"/>
    <Setter Property="Foreground" Value="#0B1A30"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#F8FAFC"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="Margin" Value="0,6,16,6"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="TextBox">
    <Setter Property="Margin" Value="0,4,0,8"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Background" Value="#0F2744"/>
    <Setter Property="Foreground" Value="#E2E8F0"/>
    <Setter Property="BorderBrush" Value="#2A4A73"/>
    <Setter Property="CaretBrush" Value="#7DD3FC"/>
  </Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,4,0,8"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Opacity" Value="0.62"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,8,0,2"/></Style>
  <Style x:Key="Id" TargetType="TextBlock"><Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#7DD3FC"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#132744"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,10,10"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#10233F"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/></Style>
  <Style x:Key="Chip" TargetType="Border"><Setter Property="Background" Value="#1E4A7A"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0,4,8,4"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,12,0,0"/></Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="#CBD5E1"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Root" Background="#152844" CornerRadius="6,6,0,0" Margin="0,0,6,0" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#1E4A7A"/>
              <Setter Property="Foreground" Value="#F8FAFC"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListView">
    <Setter Property="Background" Value="#0A1628"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="#E2E8F0"/>
  </Style>
  <Style TargetType="ListViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0,2"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#E2E8F0"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#152844"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#1E4A7A"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
