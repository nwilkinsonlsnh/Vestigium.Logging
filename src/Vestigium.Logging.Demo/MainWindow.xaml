<Window x:Class="Vestigium.Logging.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vestigium.Logging gallery"
        Height="880" Width="1320"
        MinHeight="640" MinWidth="960"
        Background="#0B1A30" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel LastChildFill="False" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#7DD3FC" Text="VESTIGIUM SUITE"/>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Vestigium.Logging gallery"/>
        <TextBlock Opacity="0.7" Text="Serilog JSON Lines for PowerBI · flood protection · WPF-safe subscribers"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock Opacity="0.9" FontFamily="Cascadia Mono, Consolas" FontSize="16" Text="{Binding WrittenCaption}" HorizontalAlignment="Right"/>
        <TextBlock Opacity="0.55" FontFamily="Cascadia Mono, Consolas" Text="{Binding SuppressedCaption}" HorizontalAlignment="Right"/>
      </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Overview"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource OverviewTab}"/></TabItem>
      <TabItem Header="Configuration"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConfigurationTab}"/></TabItem>
      <TabItem Header="Flood"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource FloodTab}"/></TabItem>
      <TabItem Header="Live feed"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource LiveFeedTab}"/></TabItem>
      <TabItem Header="Schema"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SchemaTab}"/></TabItem>
      <TabItem Header="Taxonomy"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaxonomyTab}"/></TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Opacity="0.55" Text="{Binding StatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
